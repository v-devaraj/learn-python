     "text": [
      "1D array is:\n",
      "[1 2 3 4]\n",
      "2D array is:\n",
      "[[1 2 3 4]\n",
      " [5 6 7 8]]\n"
     ]
    }
   ],
   "source": [
    "array_1d = np.array([1, 2, 3, 4])\n",
    "print(f'1D array is:')\n",
    "print(array_1d)\n",
